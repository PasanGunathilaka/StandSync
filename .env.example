# ---- Runtime ----
NODE_ENV=development
PORT=3978

# ---- Claude ----
# LLM_PROVIDER=claude-code uses the Claude Code CLI with your existing subscription
# login (or CLAUDE_CODE_OAUTH_TOKEN). It does NOT need ANTHROPIC_API_KEY.
# Use LLM_PROVIDER=mock to demo or run tests with no model calls at all.
LLM_PROVIDER=claude-code
CLAUDE_CODE_PATH=claude
LLM_TIMEOUT_MS=90000
# StandSync uses Claude to INTERPRET standups only. Claude never writes to Jira.
# Only required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Jira (REST API v3, Basic auth with email + API token) ----
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Demo tooling only (npm run seed:jira). The runtime NEVER reads this — a Jira
# key already names its project, so StandSync handles TES-41, PAY-142 and
# BCPM-33 in the same standup, across any project the credentials can see.
JIRA_PROJECT_KEY=PAY

# ---- Status names as they appear in your Jira workflow ----
# Default workflow status names, used for every project unless overridden below.
STATUS_DONE=Done
STATUS_IN_PROGRESS=In Progress
STATUS_TODO=To Do

# Optional per-project status names, for projects whose workflow differs from
# the defaults above. JSON keyed by project key; each field is optional.
#   JIRA_STATUS_OVERRIDES={"BCPM":{"done":"Closed","inProgress":"Doing"}}
JIRA_STATUS_OVERRIDES=

# ---- Microsoft Teams ----
# Teams app identity (a GUID). Generated by `npm run teams:package` if unset.
TEAMS_APP_ID=
# Bot registration credentials from Azure Bot / Developer Portal.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Only messages from this conversation id are processed. Leave blank in development
# to allow the /dev/* endpoints to drive the pipeline without Teams.
TEAMS_ALLOWED_CONVERSATION_ID=

# ---- V2: natural channel listening (ambient mode) ----
# false (default) = V1 behaviour: StandSync only acts on messages addressed to it
#                   (in a channel, that means @StandSync).
# true            = StandSync observes every message in the conversations below and
#                   decides for itself which are relevant. Requires the
#                   ChannelMessage.Read.Group RSC grant — see docs/teams-setup.md.
# Receiving every message and replying to every message are different things:
# irrelevant messages get no visible response at all.
STANDSYNC_AMBIENT_MODE=false
# Extra conversation ids ambient mode may observe, comma-separated.
# TEAMS_ALLOWED_CONVERSATION_ID is always included. There is no "all channels"
# value on purpose — ambient listening is opt-in per conversation.
STANDSYNC_AMBIENT_CONVERSATION_IDS=
# Public dev-tunnel base URL Teams posts to. When set, `npm run demo` verifies
# the live tunnel still matches it — catching a changed URL before the demo.
TEAMS_PUBLIC_URL=
TEAMS_MESSAGING_ENDPOINT=/api/messages
# Local development only. Leave false unless testing without a bot registration.
TEAMS_ALLOW_UNAUTHENTICATED=false

# ---- Behaviour ----
# author_only = only the standup author may approve. anyone = any channel member.
APPROVAL_POLICY=anyone
STALE_DAYS=5

# ---- V2: decision policy ----
# Read only by src/policy/decision-policy.ts, so there is exactly one place that
# decides "propose / review / clarify / stay silent".
# At or above this, a valid low-risk change is pre-ticked on the card.
POLICY_AUTO_SELECT_CONFIDENCE=0.8
# Below this, StandSync asks the developer instead of guessing.
POLICY_CLARIFY_CONFIDENCE=0.5
# Classifier confidence needed to let an ambient message into the pipeline.
POLICY_RELEVANCE_CONFIDENCE=0.6
# Per-agent LLM ceiling. Shorter than LLM_TIMEOUT_MS: these are small calls.
AGENT_TIMEOUT_MS=45000

# ---- V2: conversational context ----
# StandSync never sends channel history to Claude wholesale — only this many
# recent messages from the same thread/conversation, within this time window.
CONTEXT_MESSAGE_LIMIT=5
CONTEXT_WINDOW_MINUTES=120

# ---- Storage ----
DATABASE_PATH=./data/standsync.db
