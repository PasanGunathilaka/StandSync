# ---- Runtime ----
NODE_ENV=development
PORT=3978

# ---- Claude ----
# StandSync uses Claude to INTERPRET standups only. Claude never writes to Jira.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Jira (REST API v3, Basic auth with email + API token) ----
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PAY

# ---- Status names as they appear in your Jira workflow ----
STATUS_DONE=Done
STATUS_IN_PROGRESS=In Progress
STATUS_TODO=To Do

# ---- Microsoft Teams ----
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Only messages from this conversation id are processed. Leave blank in development
# to allow the /dev/* endpoints to drive the pipeline without Teams.
TEAMS_ALLOWED_CONVERSATION_ID=

# ---- Behaviour ----
# author_only = only the standup author may approve. anyone = any channel member.
APPROVAL_POLICY=anyone
STALE_DAYS=5

# ---- Storage ----
DATABASE_PATH=./data/standsync.db
