{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Bistec Global",
    "websiteUrl": "https://www.bistecglobal.com",
    "privacyUrl": "https://www.bistecglobal.com/privacy",
    "termsOfUseUrl": "https://www.bistecglobal.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "StandSync",
    "full": "StandSync — standups to Jira"
  },
  "description": {
    "short": "Your team talks. Jira stays current.",
    "full": "StandSync reads daily standup messages in this channel, uses Claude to understand what happened to each Jira ticket mentioned, and proposes status transitions and comments as an Adaptive Card. Claude only interprets and recommends — nothing is written to Jira until a human clicks Approve."
  },
  "accentColor": "#2F5BEA",
  "bots": [
    {
      "botId": "${{MICROSOFT_APP_ID}}",
      "scopes": ["team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
