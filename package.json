{
  "name": "standsync",
  "version": "0.1.0",
  "private": true,
  "description": "Your team talks. Jira stays current. AI recommends, human approves, StandSync executes.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:jira": "tsx scripts/seed-jira.ts",
    "dev:post": "tsx scripts/dev-post.ts",
    "teams:icons": "tsx scripts/make-icons.ts",
    "teams:package": "tsx scripts/package-teams-app.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@microsoft/teams.apps": "^2.0.16",
    "@microsoft/teams.cards": "^2.0.16",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
